#include <iostream>
#include <string>

using namespace std;
class Product{
	public:
		string Name;
		float Rating;
		
		Product(){}
		Product(string N, float R){
			Name = N;
			Rating = R;
		}
};


void SelectionSort(Product arr[], int n){
	
	for(int i=0;i<n-1;i++){

		Biggest = i;
		for(int j = i+1; j<n;j++){
			if(arr[j].Rating > arr[Biggest].Rating){
				Smallest = j;
			}
		}
		swap(arr[i],arr[Biggest]);
	}
       
}


int main(){
	
	int n;
	cout<< "Enter No . of Products: " << endl;
	cin>> n;
	Product *Prod = new Product[n];
	
	for (int i=0;i<n;i++){
		string N;
		float R;
		cout<<"Enter Name: " << endl;
		cin>> N;
		cout<< "Enter Rating (1.0 - 5.0): " << endl;
		cin>>R;
		Prod[i] = Product(N,R);
	}
	
	SelectionSort(Prod,n);
	cout << "Sorted: " << endl;
	for (int i=0;i<n;i++){
		cout<< "Name: " <<Prod[i].Name << " - Rating: " << Prod[i].Rating <<endl;
	}
	delete[] Prod;
}
