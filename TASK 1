#include <iostream>
#include <string>

using namespace std;
class Product{
	public:
		int ID;
		string Name;
		int Date;
		
		Product(){}
		Product(int I,string N, int D){
			ID = I;
			Name = N;
			Date = D;
		}
};


int BubbleSort(Product *arr, int n){
	int Counter = 0;
    for(int i=0;i<n-1;i++){
        bool Flag = false;
        for(int j=0;j<n-i-1;j++){
            if(arr[j].Date > arr[j+1].Date){
                swap(arr[j],arr[j+1]);
                Flag = true;
                Counter +=1;
            }
        }
        
        if (!Flag){
            return Counter;
        }
    }
    return Counter;
}


int main(){
	
	int n;
	cout<< "Enter No . of Products: " << endl;
	cin>> n;
	Product *Prod = new Product[n];
	
	for (int i=0;i<n;i++){
		string N;
		int D;
		cout<<"Enter Name: " << endl;
		cin>> N;
		cout<< "Enter Date: " << endl;
		cin>>D;
		Prod[i] = Product(i,N,D);
	}
	
	cout<< "Swaps: " <<BubbleSort(Prod,n)<<endl;
	cout << "Sorted: " << endl;
	for (int i=0;i<n;i++){
		cout<< "ID: " << Prod[i].ID << " - Name: " <<Prod[i].Name << " - Date: " << Prod[i].Date <<endl;
	}
	delete[] Prod;
}
